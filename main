#!/usr/bin/env python3
"""
Barrels – Ubuntu Customizer

Features:
 • Appearance, Themes, Icons, Fonts, Window Management, Extensions,
   Startup Apps, Shortcuts, Dock, Power, Workspaces, Accessibility
"""

