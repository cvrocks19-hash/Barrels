# ----------------------------------------------------------------------
# Flask – optional (installed via apt/requirements). If Flask is not
# available the script falls back to the original CLI mode.
# ----------------------------------------------------------------------
try:
    from flask import Flask, render_template, url_for, redirect, flash, request
except Exception:        # pragma: no cover
    Flask = None   # type: ignore

# ----------------------------------------------------------------------
# MAIN CLASS – UbuntuCustomizer (all logic lives here)
# ----------------------------------------------------------------------
